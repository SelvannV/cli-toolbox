{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022", // <--- Changed from "NodeNext" to "ES2022"
    "moduleResolution": "bundler", // <--- Changed to "bundler"

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,

    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
